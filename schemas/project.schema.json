{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project contract",
  "type": "object",
  "required": ["name", "repos", "environments", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slug", "url", "base"],
        "additionalProperties": false,
        "properties": {
          "slug": { "type": "string" },
          "url": { "type": "string" },
          "base": { "type": "string" }
        }
      }
    },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "readOnly": { "type": "boolean" },
          "env": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": ["functional", "security", "analytics", "performance", "seo", "accessibility", "visual", "api", "responsive", "i18n"]
      },
      "additionalProperties": {
        "type": "object",
        "required": ["tool", "suite"],
        "additionalProperties": false,
        "properties": {
          "tool": { "enum": ["playwright"] },
          "suite": { "type": "string" },
          "project": { "type": "string" },
          "needsBrowser": { "type": "boolean" }
        }
      }
    }
  }
}
